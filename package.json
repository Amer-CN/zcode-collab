{
  "name": "dsh-collab-mode",
  "version": "0.2.0",
  "description": "DeepSeek Harness 插件：协作模式 —— 五个角色子智能体工具（executor / code-reviewer / researcher / advisor / vision-reader）+ 协作纪律系统提示段 + 改动前拦截、工具调用审计、轮次结束告警三个代码级钩子 + 设置面板（按角色选模型/推理强度 + 运行时自检）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "content",
    "build.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "collab",
    "subagent",
    "workflow"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
